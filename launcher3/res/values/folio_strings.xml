    <string name="drawer_tabs_settings_category">Your tabs</string>
    <string name="drawer_tabs_settings_empty">No tabs yet</string>
    <string name="drawer_tabs_settings_hint">Apps in a tab are shown only in that tab, not under Apps. Tap a tab to choose its apps, rename, reorder or delete it. You can also manage tabs from the app drawer, swipe left and right between them, and add any app to a tab from its long-press menu.</string>
