    <string name="double_tap_lock_setup_title">Turn on double-tap to lock</string>
    <string name="double_tap_lock_setup_message">To turn the screen off, Folio needs its \"Folio screen lock\" accessibility service. It only locks the screen and doesn\'t read anything on screen.\n\nIn Accessibility settings, open Folio screen lock and turn it on.</string>
    <string name="double_tap_lock_open_settings">Open settings</string>
    <string name="lock_service_label">Folio screen lock</string>
    <string name="lock_service_description">Lets Folio turn your screen off when you double-tap an empty spot, and open notifications when you swipe down. It doesn\'t observe or read anything on screen.</string>
