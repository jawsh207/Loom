<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="app.folio.launcher">
    <uses-sdk android:targetSdkVersion="33" android:minSdkVersion="30"/>
    <!--
    Folio's app manifest: a copy of Launcher3's AndroidManifest.xml with Folio's package, name
    and icon, plus the double-tap lock service. Merged with AndroidManifest-common.xml.
    -->

    <!-- Permission required to start a WidgetPickerActivity. -->
    <permission android:name="${applicationId}.permission.START_WIDGET_PICKER_ACTIVITY"
        android:protectionLevel="signature|privileged" />

    <!-- Folio: swipe down on the home screen opens the notification shade. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Only used by the feed panel, which is off until you turn it on. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:backupAgent="com.android.launcher3.LauncherBackupAgent"
        android:fullBackupOnly="true"
        android:fullBackupContent="@xml/backupscheme"
        android:hardwareAccelerated="true"
        android:icon="@drawable/folio_ic_launcher"
        android:label="@string/folio_app_name"
        tools:replace="android:icon,android:label"
        android:theme="@style/AppTheme"
        android:largeHeap="@bool/config_largeHeap"
        android:restoreAnyVersion="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true" >

        <!-- Folio leaves out Launcher3's App Functions (home screen access for AI agents). -->

        <!--
        Main launcher activity. When extending only change the name, and keep all the
        attributes and intent filters the same
        -->
        <activity
            android:name="com.android.launcher3.Launcher"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustPan"
            android:screenOrientation="unspecified"
            android:configChanges="keyboard|keyboardHidden|mcc|mnc|navigation|orientation|screenSize|screenLayout|smallestScreenSize"
            android:resizeableActivity="true"
            android:resumeWhilePausing="true"
            android:taskAffinity=""
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.intent.action.SHOW_WORK_APPS" />
                <action android:name="android.intent.action.ALL_APPS" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.MONKEY"/>
                <category android:name="android.intent.category.LAUNCHER_APP" />
            </intent-filter>
            <meta-data
                android:name="com.android.launcher3.grid.control"
                android:value="${packageName}.grid_control" />
        </activity>

        <activity android:name="com.android.launcher3.widgetpicker.WidgetPickerActivity"
            android:theme="@style/WidgetPickerActivityTheme"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:launchMode="singleTop"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:permission="${applicationId}.permission.START_WIDGET_PICKER_ACTIVITY">
            <intent-filter>
                <action android:name="android.intent.action.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
        Folio's icon in other launchers: asks to make Folio the default home app (or opens
        Folio's settings when it already is).
        -->
        <activity
            android:name="com.android.launcher3.folio.SetDefaultHomeActivity"
            android:label="@string/folio_app_name"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:taskAffinity="app.folio.launcher.sethome"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Drawer tabs screen, opened from Folio's settings -->
        <activity
            android:name="com.android.launcher3.folio.DrawerTabsActivity"
            android:label="@string/drawer_tabs_settings_title"
            android:theme="@style/HomeSettings.Theme"
            android:exported="false"
            android:autoRemoveFromRecents="true" />

        <!-- Home screen and app drawer grid sizes -->
        <activity
            android:name="com.android.launcher3.folio.GridSettingsActivity"
            android:label="@string/folio_grid_title"
            android:theme="@style/FolioFeedSettings"
            android:exported="false"
            android:autoRemoveFromRecents="true" />

        <!-- Feed panel settings and subscriptions -->
        <activity
            android:name="com.android.launcher3.folio.feed.FeedSettingsActivity"
            android:label="@string/feed_settings_title"
            android:theme="@style/FolioFeedSettings"
            android:exported="false"
            android:autoRemoveFromRecents="true" />

        <service
            android:name="com.android.launcher3.folio.feed.FeedRefreshJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- Per-app icon picker, opened from an app's "Edit icon" menu entry -->
        <activity
            android:name="com.android.launcher3.folio.IconPickerActivity"
            android:label="@string/icon_edit_title"
            android:theme="@style/HomeSettings.Theme"
            android:exported="false"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true" />

        <!-- Double-tap to lock: performs GLOBAL_ACTION_LOCK_SCREEN, reads no screen content. -->
        <service
            android:name="com.android.launcher3.folio.LockScreenService"
            android:label="@string/lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/folio_lock_screen_service" />
        </service>

    </application>
</manifest>
